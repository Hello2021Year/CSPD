index 000000000..631378ddc
--- /dev/null
+++ b/python/sglang/srt/soft_prompt/scheduling.py
@@ -0,0 +1,81 @@
+"""Scheduler-side soft-prompt handling: attach to a Req and emit prefill overrides."""
+
+from __future__ import annotations
+
+import os
+import time
+from array import array
+from dataclasses import dataclass
+from typing import List, Optional, Tuple
+
+import torch
+
+from sglang.srt.soft_prompt.pool import get_soft_prompt_pool
+from sglang.srt.soft_prompt.utils import is_soft_prompt_id
+
+
+@dataclass(frozen=True)
+class SoftPromptRef:
+    name: str
+    version: Optional[int]
+    start: int  # absolute position of the first placeholder token
+    length: int
+
+
+def attach_soft_prompt(req, recv_req) -> None:
+    """Record the request's soft prompt (pool reference and placeholder span).
+
+    Prefix-cache isolation needs no extra key: the soft-prompt span already carries
+    per-prompt, per-version token ids (see soft_prompt.utils.SOFT_PROMPT_ID_BASE), so the
+    radix tree diverges exactly where the soft prompt starts and tokens before it stay
+    shareable across tenants.
+    """
+    pool = get_soft_prompt_pool()
+    entry = pool.entries.get(recv_req.soft_prompt) if pool is not None else None
+    if (entry is None and pool is not None
+            and os.environ.get("UNIQUE_ADAPTER_REGISTERED") == "1"):
+        staged = getattr(pool, "cpu_staged", {})
+        tensor = staged.pop(recv_req.soft_prompt, None)
+        if tensor is not None:
+            from sglang.srt.unique_adapter_audit import loading
+            started = time.monotonic_ns()
+            entry = pool.load(recv_req.soft_prompt, tensor, recv_req.soft_prompt_version)
+            loading("sp_cpu_to_gpu", recv_req.soft_prompt, started)
+    if entry is None:
+        req.set_finish_with_abort(
+            f"soft prompt {recv_req.soft_prompt!r} is not loaded on this worker"
+        )
+        return
+    req.soft_prompt = SoftPromptRef(
+        name=recv_req.soft_prompt,
+        version=recv_req.soft_prompt_version,
+        start=recv_req.soft_prompt_start,
+        length=entry.length,
+    )
+
+
+def soft_prompt_extend_overrides(
+    req, pre_len: int, extend_len: int, flat_offset: int
+) -> Optional[Tuple[torch.Tensor, List[int]]]:
+    """Embeddings and flat extend-batch positions for the placeholders in this chunk.
+
+    ``pre_len`` is the cached-prefix length, ``extend_len`` the number of tokens computed
+    now, and ``flat_offset`` where this request's tokens start in the flattened batch.
+    """
+    ref: SoftPromptRef = req.soft_prompt
+    lo = max(ref.start, pre_len)
+    hi = min(ref.start + ref.length, pre_len + extend_len)
+    if lo >= hi:
+        return None
+    offsets = list(range(lo - ref.start, hi - ref.start))
+    positions = [flat_offset + (p - pre_len) for p in range(lo, hi)]
+    embeds = get_soft_prompt_pool().gather(ref.name, ref.version, offsets)
+    return embeds, positions
+
+
+def map_soft_prompt_ids_for_model(token_ids, placeholder_id: int):
+    """Replace per-prompt soft-prompt ids (outside the vocabulary) by the placeholder id."""
+    if not any(is_soft_prompt_id(t) for t in token_ids):
+        return token_ids
+    mapped = [placeholder_id if is_soft_prompt_id(t) else t for t in token_ids]
+    return array("q", mapped) if isinstance(token_ids, array) else mapped
diff --git a/python/sglang/srt/soft_prompt/utils.py b/python/sglang/srt/soft_prompt/utils.py
new file mode 100644
index 000000000..17db8adaa
--- /dev/null
+++ b/python/sglang/srt/soft_prompt/utils.py
@@ -0,0 +1,68 @@
+"""Helpers shared by the tokenizer (CPU) and model-runner (GPU) sides of soft prompts."""
+
+from __future__ import annotations
+
+from typing import List, Optional, Tuple
+
+from safetensors import safe_open
+
+# Text marker replaced by the placeholder-id run of the request's soft prompt.
+SOFT_PROMPT_MARKER = "<|soft_prompt|>"
+# Logit bias that keeps the input-only placeholder id from ever being sampled.
+SOFT_PROMPT_LOGIT_BIAS = -1.0e4
+# Soft-prompt positions are stored in a request's token ids as per-prompt ids outside the
+# vocabulary (like multimodal pad values), so the prefix cache keys them per prompt and
+# version while tokens before the soft prompt stay shareable across tenants. The model
+# never sees these ids: they are mapped back to the placeholder id when building its input.
+# Range: above multimodal pad values ([1e6, 1e6 + 2**30)) and below int32 max.
+SOFT_PROMPT_ID_BASE = 1_200_000_000
+SOFT_PROMPT_ID_LIMIT = 2**31 - 1
+
+
+def soft_prompt_token_ids(version: int, length: int, max_len: int) -> List[int]:
+    """Per-prompt token ids for one (re)load of a soft prompt."""
+    start = SOFT_PROMPT_ID_BASE + version * max_len
+    if start + length > SOFT_PROMPT_ID_LIMIT:
+        raise ValueError(
+            "soft prompt id space exhausted; restart the server to reset versions"
+        )
+    return list(range(start, start + length))
+
+
+def is_soft_prompt_id(token_id: int) -> bool:
+    return token_id >= SOFT_PROMPT_ID_BASE
+
+
+def parse_soft_prompt_paths(paths: Optional[List[str]]) -> List[Tuple[str, str]]:
+    parsed = []
+    for item in paths or []:
+        if "=" not in item:
+            raise ValueError(
+                f"--soft-prompt-paths entries must be NAME=PATH, got {item!r}"
+            )
+        name, path = item.split("=", 1)
+        if not name or not path:
+            raise ValueError(
+                f"--soft-prompt-paths entries must be NAME=PATH, got {item!r}"
+            )
+        parsed.append((name, path))
+    names = [n for n, _ in parsed]
+    if len(set(names)) != len(names):
+        raise ValueError("--soft-prompt-paths has duplicate names")
+    return parsed
+
+
+def soft_prompt_length(path: str) -> int:
+    """Prompt length read from the safetensors header (no tensor data is loaded)."""
+    with safe_open(path, framework="pt") as f:
+        keys = list(f.keys())
+        if len(keys) != 1:
+            raise ValueError(
+                f"soft prompt file {path} must hold exactly one tensor, found {keys}"
+            )
+        shape = f.get_slice(keys[0]).get_shape()
+    if len(shape) != 2:
+        raise ValueError(
+            f"soft prompt tensor in {path} must be [length, hidden_size], got {shape}"
+        )
+    return int(shape[0])
