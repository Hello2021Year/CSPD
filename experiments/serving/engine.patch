diff --git a/python/sglang/srt/unique_adapter_audit.py b/python/sglang/srt/unique_adapter_audit.py
new file mode 100644
index 000000000..9f227ecbb
--- /dev/null
+++ b/python/sglang/srt/unique_adapter_audit.py
@@ -0,0 +1,50 @@
+"""Opt-in serving experiment audit; disabled unless UNIQUE_ADAPTER_AUDIT is set.
+
+Binary token records: little-endian monotonic_ns:uint64, numeric request ID:uint32,
+cumulative committed output tokens:uint32. Records are made after the existing
+GPU->CPU synchronization, never inferred from HTTP chunk boundaries.
+"""
+import atexit
+import json
+import os
+import struct
+import time
+
+_path = os.environ.get("UNIQUE_ADAPTER_AUDIT")
+_tokens = None
+_loads = None
+_last_flush = 0
+
+
+def tp_rank():
+    from sglang.srt.runtime_context import get_parallel
+    return get_parallel().tp_rank
+
+
+def token(req):
+    global _tokens, _last_flush
+    if not _path or not req.rid.startswith("ub-"):
+        return
+    if tp_rank() != 0:
+        return
+    if _tokens is None:
+        _tokens = open(_path + ".tokens.bin", "ab", buffering=1024 * 1024)
+        atexit.register(_tokens.close)
+    now = time.monotonic_ns()
+    _tokens.write(struct.pack("<QII", now, int(req.rid[3:]), len(req.output_ids)))
+    if now - _last_flush > 1_000_000_000 or len(req.output_ids) >= req.sampling_params.max_new_tokens:
+        _tokens.flush()
+        _last_flush = now
+
+
+def loading(kind, name, start_ns, **details):
+    global _loads
+    if not _path:
+        return
+    rank = tp_rank()
+    if _loads is None:
+        suffix = ".loads.jsonl" if rank == 0 else f".tp{rank}.loads.jsonl"
+        _loads = open(_path + suffix, "a", buffering=1)
+        atexit.register(_loads.close)
+    _loads.write(json.dumps(dict(kind=kind, name=name, start_ns=start_ns,
+                                 end_ns=time.monotonic_ns(), tp_rank=rank, **details)) + "\n")
diff --git a/python/sglang/srt/unique_adapter_cpu_store.py b/python/sglang/srt/unique_adapter_cpu_store.py
new file mode 100644
index 000000000..b4469fd29
--- /dev/null
+++ b/python/sglang/srt/unique_adapter_cpu_store.py
@@ -0,0 +1,59 @@
+"""Experiment-only, same-host immutable CPU tensor store shared across TP ranks.
+
+The owner is a CPU helper in the serving job's allocation. Its sealed memfd contains fully
+materialized weights; mapping it does not read checkpoint data from storage.
+"""
+import json
+import mmap
+import os
+from pathlib import Path
+import socket
+
+_stores = {}
+
+
+def weights(adapter_path):
+    import torch
+
+    index_path = os.environ.get("UNIQUE_ADAPTER_CPU_STORE")
+    dynamic = os.environ.get("UNIQUE_ADAPTER_DYNAMIC_STORE") == "1"
+    if dynamic:
+        if index_path:
+            raise ValueError("Static and dynamic CPU stores cannot both be enabled")
+        index_path = str(Path(adapter_path) / "cpu-store-index.json")
+    if not index_path:
+        return None
+    if dynamic or index_path not in _stores:
+        index = json.loads(Path(index_path).read_text())
+        if index["hostname"] != socket.gethostname():
+            raise ValueError("CPU tensor store must be on the serving node")
+        if not index["sealed"] or not index["ready"]:
+            raise ValueError("CPU tensor store is not immutable and ready")
+        if dynamic:
+            # the store must have been written by this Slurm allocation
+            owner = os.environ.get("SLURM_JOB_ID")
+            if not owner or index["owner_job"] != owner:
+                raise ValueError("Dynamic CPU store must belong to the serving allocation")
+        fd = os.open(index["memfd_path"], os.O_RDONLY)
+        try:
+            if os.fstat(fd).st_size != index["bytes"]:
+                raise ValueError("CPU tensor store size mismatch")
+            # Private mapping retains shared physical pages on reads. It also
+            # protects the shared store if a caller accidentally writes a view.
+            mapping = mmap.mmap(fd, 0, access=mmap.ACCESS_COPY)
+        finally:
+            os.close(fd)
+        if not dynamic:
+            _stores[index_path] = index, mapping
+    if not dynamic:
+        index, mapping = _stores[index_path]
+    # Dynamic mappings are owned only by the tensor buffers. Unloading an
+    # adapter drops those references; no global cache retains past requests.
+    item = index["adapters"][str(Path(adapter_path).resolve())]
+    tensors = {}
+    for spec in index["layout"]:
+        tensor = torch.frombuffer(mapping, dtype=torch.bfloat16,
+                                  count=spec["numel"],
+                                  offset=item["offset"] + spec["offset"])
+        tensors[spec["name"]] = tensor.reshape(spec["shape"])
+    return tensors
