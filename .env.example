# Optional runtime overrides. The Slurm scripts otherwise use python3 from PATH
# and a project-local Hugging Face cache.

SOFT_PROMPT_PYTHON=/path/to/soft-prompt-runtime/bin/python
HF_HOME=/path/to/large/huggingface-cache

# Optional SGLang launcher tuning. Total GPUs used by one engine are TP * DP.
SOFT_PROMPT_SGLANG_TP_SIZE=1
SOFT_PROMPT_SGLANG_DP_SIZE=1
SOFT_PROMPT_SGLANG_BATCH_SIZE=8192
SOFT_PROMPT_SGLANG_LOG_LEVEL=error
# Example for RTX PRO 6000; use triton for OLMo3 because SGLang rejects flashinfer.
# SOFT_PROMPT_SGLANG_ATTENTION_BACKEND=flashinfer

# Account, QOS, partition, GPU type, and other platform policy belong in the
# sbatch command or a site-local wrapper, not in this repository.
